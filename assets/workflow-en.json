{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Zhongkao English Reading · AI Item-Writing Workflow",
    "locale": "en",
    "quality_profile": "showcase",
    "output": "assets/workflow-en.html"
  },
  "lanes": [
    {
      "id": "main",
      "label": "Main chain · Generator"
    },
    {
      "id": "support",
      "label": "Knowledge bases · Appender"
    }
  ],
  "phases": [
    {
      "id": "source",
      "label": "Source",
      "fromCol": 0,
      "toCol": 0
    },
    {
      "id": "part1",
      "label": "Part 1 · Rewrite",
      "fromCol": 1,
      "toCol": 2,
      "variant": "emphasis"
    },
    {
      "id": "part2",
      "label": "Part 2 · Items",
      "fromCol": 3,
      "toCol": 4,
      "variant": "emphasis"
    },
    {
      "id": "deliver",
      "label": "Deliver",
      "fromCol": 5,
      "toCol": 5
    }
  ],
  "mainPath": [
    "src",
    "rewrite",
    "metrics",
    "items",
    "validate",
    "export"
